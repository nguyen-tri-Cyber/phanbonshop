# ====================================================================
# PHAN BON SHOP - BIẾN MÔI TRƯỜNG DÀNH CHO LOCAL DEVELOPMENT
# ====================================================================

# 1. Cấu hình Môi trường Ứng dụng
NODE_ENV=development

# Cổng truy cập của các Services & Apps (Canonical Ports)
GATEWAY_PORT=8080
FRONTEND_PORT=3000
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_PORT=3002
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_PORT=3003
ORDER_SERVICE_URL=http://localhost:3003
INVENTORY_SERVICE_PORT=3004
INVENTORY_SERVICE_URL=http://localhost:3004
CUSTOMER_SERVICE_PORT=3005
CUSTOMER_SERVICE_URL=http://localhost:3005
CONTENT_SERVICE_PORT=3006
CONTENT_SERVICE_URL=http://localhost:3006

# Cấu hình CORS (danh sách domain phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 2. Cấu hình MySQL (Host port 3307 để tránh xung đột với MySQL port 3306 nội bộ máy host)
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_USER=phanbon_user
MYSQL_PASSWORD=phanbon_secret

# 3. Cấu hình Redis 7 (Cache, Rate-limit, Session)
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# 4. Cấu hình MinIO Object Storage (Lưu trữ ảnh sản phẩm, banner, tài liệu)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123456
MINIO_BUCKET_PRODUCTS=product-images
MINIO_BUCKET_CONTENT=content-images

# 5. Database Connection URLs (Logical Database-per-service pattern)
AUTH_DATABASE_URL=mysql://phanbon_user:phanbon_secret@localhost:3307/auth_db
PRODUCT_DATABASE_URL=mysql://phanbon_user:phanbon_secret@localhost:3307/product_db
ORDER_DATABASE_URL=mysql://phanbon_user:phanbon_secret@localhost:3307/order_db
INVENTORY_DATABASE_URL=mysql://phanbon_user:phanbon_secret@localhost:3307/inventory_db
CUSTOMER_DATABASE_URL=mysql://phanbon_user:phanbon_secret@localhost:3307/customer_db
CONTENT_DATABASE_URL=mysql://phanbon_user:phanbon_secret@localhost:3307/content_db

# 6. Bảo mật, Token & Giao tiếp Nội bộ (Security & Internal Auth)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_phanbonshop_32chars_min
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_phanbonshop_32chars_min
JWT_EXPIRES_IN=3600
INTERNAL_SERVICE_SECRET=your_internal_service_mesh_shared_secret_2026
