generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("CONTENT_DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Post {
  id             String     @id @default(uuid())
  title          String     @db.VarChar(255)
  slug           String     @unique @db.VarChar(255)
  excerpt        String?    @db.Text
  content        String     @db.LongText
  coverImageUrl  String?    @db.VarChar(500)
  status         PostStatus @default(DRAFT)
  seoTitle       String?    @db.VarChar(255)
  seoDescription String?    @db.Text
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@map("posts")
}

enum BannerStatus {
  ACTIVE
  INACTIVE
}

model Banner {
  id        String       @id @default(uuid())
  title     String       @db.VarChar(255)
  imageUrl  String       @db.VarChar(500)
  targetUrl String?      @db.VarChar(500)
  position  String       @default("HOME_HERO") @db.VarChar(50)
  startAt   DateTime?
  endAt     DateTime?
  status    BannerStatus @default(ACTIVE)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([position])
  @@index([status])
  @@map("banners")
}
