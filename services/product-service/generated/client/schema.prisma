generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("PRODUCT_DATABASE_URL")
}

enum Status {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum AgriculturalAttributeType {
  CROP
  GROWTH_STAGE
  APPLICATION_METHOD
  NUTRIENT_TYPE
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  parentId    String?
  parent      Category?  @relation("CategoryParentChild", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryParentChild")
  status      Status     @default(ACTIVE)
  sortOrder   Int        @default(0)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
  @@index([status])
  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  logoUrl     String?
  status      Status    @default(ACTIVE)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@map("brands")
}

model Product {
  id                  String                  @id @default(uuid())
  name                String
  slug                String                  @unique
  sku                 String                  @unique
  shortDescription    String?                 @db.Text
  description         String?                 @db.LongText
  composition         String?                 @db.Text
  usageInstructions   String?                 @db.Text
  storageInstructions String?                 @db.Text
  warningInformation  String?                 @db.Text
  manufacturer        String?
  origin              String?
  brandId             String?
  brand               Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categoryId          String?
  category            Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  price               Decimal                 @db.Decimal(12, 2)
  compareAtPrice      Decimal?                @db.Decimal(12, 2)
  status              ProductStatus           @default(DRAFT)
  featured            Boolean                 @default(false)
  bestSeller          Boolean                 @default(false)
  seoTitle            String?
  seoDescription      String?                 @db.Text
  variants            ProductVariant[]
  images              ProductImage[]
  agriculturalAttrs   AgriculturalAttribute[]
  reviews             Review[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([featured])
  @@index([bestSeller])
  @@index([price])
  @@map("products")
}

model ProductVariant {
  id             String        @id @default(uuid())
  productId      String
  product        Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String        @unique
  unit           String
  packageSize    String
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2)
  status         VariantStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([productId])
  @@index([status])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  objectKey String
  url       String
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([isPrimary])
  @@map("product_images")
}

model AgriculturalAttribute {
  id            String                    @id @default(uuid())
  productId     String
  product       Product                   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeType AgriculturalAttributeType
  value         String
  code          String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([productId, attributeType, value])
  @@index([attributeType, value])
  @@map("agricultural_attributes")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id               String       @id @default(uuid())
  customerId       String
  productId        String
  orderItemId      String?
  rating           Int // 1 - 5
  comment          String?      @db.Text
  status           ReviewStatus @default(APPROVED)
  verifiedPurchase Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([customerId])
  @@index([status])
  @@map("reviews")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @db.VarChar(100)
  actorRole  String   @db.VarChar(50)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(100)
  oldValue   String?  @db.LongText
  newValue   String?  @db.LongText
  ipAddress  String?  @db.VarChar(50)
  requestId  String?  @db.VarChar(100)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
