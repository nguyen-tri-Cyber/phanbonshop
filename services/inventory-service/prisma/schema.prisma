generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("INVENTORY_DATABASE_URL")
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  COMMITTED
  EXPIRED
}

enum MovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
  RESERVATION
  RELEASE_RESERVATION
  CANCELLED_ORDER
}

model Inventory {
  id               String   @id @default(uuid())
  productId        String
  variantId        String   @unique
  stockQuantity    Int      @default(0)
  reservedQuantity Int      @default(0)
  reorderLevel     Int      @default(5)
  updatedAt        DateTime @updatedAt

  @@index([productId])
  @@map("inventory")
}

model InventoryReservation {
  id            String            @id @default(uuid())
  reservationId String            @unique
  variantId     String
  quantity      Int
  referenceType String
  referenceId   String
  status        ReservationStatus @default(ACTIVE)
  expiresAt     DateTime
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([variantId])
  @@index([status])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

model InventoryMovement {
  id             String       @id @default(uuid())
  productId      String
  variantId      String
  type           MovementType
  quantity       Int
  stockBefore    Int
  stockAfter     Int
  reservedBefore Int
  reservedAfter  Int
  reason         String
  referenceType  String?
  referenceId    String?
  performedBy    String?
  requestId      String?
  createdAt      DateTime     @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([type])
  @@index([createdAt])
  @@map("inventory_movements")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @db.VarChar(100)
  actorRole  String   @db.VarChar(50)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(100)
  oldValue   String?  @db.LongText
  newValue   String?  @db.LongText
  ipAddress  String?  @db.VarChar(50)
  requestId  String?  @db.VarChar(100)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
