// Prisma schema cho auth-service
// Kết nối trực tiếp tới logical database: auth_db (MySQL)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("AUTH_DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  WAREHOUSE
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  SUSPENDED
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  passwordHash    String     @db.VarChar(255)
  fullName        String     @db.VarChar(100)
  phone           String?    @unique @db.VarChar(20)
  role            Role       @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  refreshTokens RefreshTokenSession[]

  @@map("users")
}

model RefreshTokenSession {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique @db.VarChar(128) // SHA-256 hash của refresh token
  deviceInfo String?   @db.VarChar(255)
  ipAddress  String?   @db.VarChar(50)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_token_sessions")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @db.VarChar(100)
  actorRole  String   @db.VarChar(50)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String   @db.VarChar(100)
  oldValue   String?  @db.LongText
  newValue   String?  @db.LongText
  ipAddress  String?  @db.VarChar(50)
  requestId  String?  @db.VarChar(100)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
