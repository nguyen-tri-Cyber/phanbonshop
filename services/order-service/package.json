{
  "name": "@phanbonshop/order-service",
  "version": "1.0.0",
  "private": true,
  "description": "Order and Cart service for Phan Bon Shop",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "tsc",
    "lint": "eslint \"src/**/*.ts\"",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc --noEmit",
    "test": "node test/order.unit.test.mjs",
    "test:unit": "node test/order.unit.test.mjs",
    "test:payment": "node test/payment.architecture.test.mjs",
    "test:integration": "node test/checkout.idempotency.concurrency.integration.test.mjs && node test/checkout.saga.compensation.integration.test.mjs && node test/order.lifecycle-stock.integration.test.mjs && node test/payment.architecture.test.mjs",
    "test:all": "node test/order.unit.test.mjs && node test/checkout.idempotency.concurrency.integration.test.mjs && node test/checkout.saga.compensation.integration.test.mjs && node test/order.lifecycle-stock.integration.test.mjs && node test/payment.architecture.test.mjs",
    "start": "node dist/main.js",
    "dev": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:db:push": "prisma db push",
    "prisma:validate": "prisma validate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/swagger": "^7.4.0",
    "@phanbonshop/config": "*",
    "@phanbonshop/logger": "*",
    "@phanbonshop/shared-types": "*",
    "@phanbonshop/shared-utils": "*",
    "@prisma/client": "^5.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@phanbonshop/tsconfig": "*",
    "@types/express": "^4.17.21",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.19.0"
  }
}
