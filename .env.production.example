# ==============================================================================
# PHAN BON SHOP — MẪU CẤU HÌNH MÔI TRƯỜNG PRODUCTION (.env.production)
# ==============================================================================
# CẢNH BÁO AN NINH:
# 1. TUYỆT ĐỐI KHÔNG SỬ DỤNG MẬT KHẨU HOẶC KHÓA BÍ MẬT MẶC ĐỊNH TRÊN PRODUCTION!
# 2. Toàn bộ các chuỗi bí mật (JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, INTERNAL_SERVICE_SECRET)
#    phải được sinh bằng lệnh ngẫu nhiên bảo mật cao (tối thiểu 48-64 ký tự):
#      openssl rand -base64 48
# 3. File này KHÔNG được commit trực tiếp giá trị thật vào Git.
# ==============================================================================

# 1. Môi trường Ứng dụng & Tên miền
NODE_ENV=production
DOMAIN=phanbonshop.vn
NEXT_PUBLIC_SITE_URL=https://phanbonshop.vn
CORS_ALLOWED_ORIGINS=https://phanbonshop.vn,https://admin.phanbonshop.vn

# 2. Cổng mạng dịch vụ (Chỉ Nginx mở cổng 80 & 443 ra ngoài)
PORT=3000
GATEWAY_PORT=8080
FRONTEND_PORT=3000
TLS_CERTS_DIR=/etc/letsencrypt/live/phanbonshop.vn

# Internal service discovery (override for non-Compose deployments)
AUTH_SERVICE_URL=http://auth:3001
PRODUCT_SERVICE_URL=http://product:3002
ORDER_SERVICE_URL=http://order:3003
INVENTORY_SERVICE_URL=http://inventory:3004
CUSTOMER_SERVICE_URL=http://customer:3005
CONTENT_SERVICE_URL=http://content:3006

# 3. Cơ sở dữ liệu MySQL 8.0 (Internal Docker Network)
MYSQL_ROOT_PASSWORD=CHANGE_ME_SUPER_STRONG_MYSQL_ROOT_PASSWORD_2026!
MYSQL_USER=phanbon_prod_user
MYSQL_PASSWORD=CHANGE_ME_STRONG_PHANBON_DB_PASSWORD_2026!

# Database Connection URLs (Tên host là 'mysql' trong mạng Docker nội bộ)
DATABASE_URL=mysql://phanbon_prod_user:CHANGE_ME_STRONG_PHANBON_DB_PASSWORD_2026!@mysql:3306/product_db
AUTH_DATABASE_URL=mysql://phanbon_prod_user:CHANGE_ME_STRONG_PHANBON_DB_PASSWORD_2026!@mysql:3306/auth_db
PRODUCT_DATABASE_URL=mysql://phanbon_prod_user:CHANGE_ME_STRONG_PHANBON_DB_PASSWORD_2026!@mysql:3306/product_db
ORDER_DATABASE_URL=mysql://phanbon_prod_user:CHANGE_ME_STRONG_PHANBON_DB_PASSWORD_2026!@mysql:3306/order_db
INVENTORY_DATABASE_URL=mysql://phanbon_prod_user:CHANGE_ME_STRONG_PHANBON_DB_PASSWORD_2026!@mysql:3306/inventory_db
CUSTOMER_DATABASE_URL=mysql://phanbon_prod_user:CHANGE_ME_STRONG_PHANBON_DB_PASSWORD_2026!@mysql:3306/customer_db
CONTENT_DATABASE_URL=mysql://phanbon_prod_user:CHANGE_ME_STRONG_PHANBON_DB_PASSWORD_2026!@mysql:3306/content_db

# 4. Redis 7 (Cache & Khóa phân tán)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_SUPER_STRONG_REDIS_PASSWORD_2026!
REDIS_URL=redis://:CHANGE_ME_SUPER_STRONG_REDIS_PASSWORD_2026!@redis:6379

# 5. MinIO S3 Object Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=phanbon_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_MINIO_ADMIN_PASSWORD_2026!
MINIO_BUCKET_PRODUCTS=product-images
MINIO_BUCKET_CONTENT=content-images

# 6. Bí mật Bảo mật & Xác thực (BẮT BUỘC ĐỔI - SINH BẰNG OPENSSL)
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48_CHARS_MIN
JWT_EXPIRES_IN=3600
INTERNAL_SERVICE_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_48_CHARS_MIN

# Google Identity Services Web Client ID. Authorized origin phải khớp NEXT_PUBLIC_SITE_URL.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
REQUIRE_GOOGLE_REGISTRATION=true
VIETQR_WEBHOOK_SECRET=CHANGE_ME_DEDICATED_VIETQR_WEBHOOK_SECRET
BANK_NAME=CHANGE_ME_BANK_NAME
BANK_CODE=CHANGE_ME_BANK_CODE
BANK_ACCOUNT_NUMBER=CHANGE_ME_BANK_ACCOUNT_NUMBER
BANK_ACCOUNT_HOLDER=CHANGE_ME_BANK_ACCOUNT_HOLDER
BANK_BRANCH=CHANGE_ME_BANK_BRANCH

# 7. Cấu hình Email & Thông báo Vận hành
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@phanbonshop.vn
SMTP_PASS=CHANGE_ME_APP_SPECIFIC_SMTP_PASSWORD
ADMIN_NOTIFICATION_EMAIL=admin@phanbonshop.vn

# 8. MoMo (enable only after injecting provider credentials through secret management)
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_ENDPOINT=https://payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://payment.momo.vn/v2/gateway/api/query
MOMO_REDIRECT_URL=https://phanbonshop.vn/checkout/thanh-cong
MOMO_IPN_URL=https://phanbonshop.vn/api/v1/payments/momo/ipn
